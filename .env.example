# Eclusa — required environment variables
# Copy to .env and fill in your values: cp .env.example .env

# LLM API (GLM via api.z.ai, or any OpenAI-compatible endpoint)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
DEFAULT_MODEL=openai:glm-5.1

# JWT secret for auth (change in production)
JWT_SECRET=eclusa-dev-secret-0123456789012345678901234

# Database (defaults match docker-compose)
DATABASE_URL=postgresql://eclusa:eclusa@localhost:5432/eclusa
